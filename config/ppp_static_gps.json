// PPP, GPS-only, static, internal auto-discovery.
// Tests: ionosphere-free PPP single-system filter; PathResolver
//        discovers obs file from data/2024-129/obs/gcgo00usa/ via
//        station-name match (data_download.station).
{
  "app_mode": "post",
  "data_source": "internal",

  "processing": {
    "mode": "PPP",
    "active_systems": [ "GPS" ],
    "signal_mode": "dual",
    "elevation_mask_deg": 10.0,
    "leap_seconds_tai": 37.0,
    "relinearize_geometry": true,
    "eigen_threads": 10,
    "satellite_interpolation_mode": "lagrange",
    "satellite_clock_interpolation_mode": "linear"
  },

  "files": {
    "internal_data_root": "./data"
    // observation_path / navigation_path left empty — PathResolver
    // auto-discovers them from the date-first layout.
  },

  "estimation": {
    "estimate_velocity": false,
    "estimate_sat_biases": false,
    "between_satellite_sd": { "enabled": false },
    "ambiguity_resolution": { "mode": 0 }
  },

  "filter": {
    "process_noise": {
      "position_q":     1e2,
      "clock_bias_q":   1e3,
      "troposphere_q":  1e-8,
      "ionosphere_q":   0.03
    },
    "initial_std": {
      "position":    100.0,
      "clock":      1000.0,
      "troposphere":  0.5,
      "ionosphere":   5.0,
      "ambiguity":  100.0
    },
    "measurement_noise": {
      "code_std_m":   0.300,
      "phase_std_m":  0.001,
      "doppler_std_m":0.500
    },
    "stochastic_model": "satellite_block"
  },

  "model_corrections": {
    "enable_troposphere": true,
    "enable_relativistic_correction": true,
    "enable_shapiro_delay": true,
    "enable_solid_earth_tide": true,
    "enable_ocean_tide_loading": true,
    "enable_pole_tide": true,
    "enable_atmospheric_loading": true,
    "enable_satellite_pco": true,
    "enable_satellite_pcv": true,
    "enable_receiver_pco": true,
    "enable_receiver_pcv": true,
    "enable_phase_windup": true,
    "enable_code_phase_bias": true
  },

  "data_download": {
    // Internal mode forces enabled=false; year/doy/station double
    // as date and station hints for PathResolver auto-discovery.
    "enabled": false,
    "year": 2024, "doy": 129,
    "station": "GCGO", "station_country": "USA",
    "atx_path": "C:/GnssProcessorSupport/products/atx/igs20.atx",
    "nc_path":  "C:/GnssProcessorSupport/products/nc/EOT20_load.nc"
  },

  "logging": {
    "enable_main_log": true,
    "enable_state_trace": true,
    "enable_residual_trace": true
  }
}
