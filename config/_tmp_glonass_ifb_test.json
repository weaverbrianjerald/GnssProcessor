// PPP-RTK
{
  "app_mode": "post",
  "data_source": "internal",

  "processing": {
    "mode": "PPP-RTK",
    //"active_systems": [ "GPS", "Galileo" ],
    "active_systems": [ "GPS", "Galileo", "BeiDou", "GLONASS" ],
    "frequency_mode": "all",
    "channel_mode": "all",
    "elevation_mask_deg": 10.0,
    "exclude_eclipsing_satellites": true,
    "eclipse_shadow_scale": 1.0,
    "leap_seconds_tai": 37.0,
    "relinearize_geometry": true,
    "eigen_threads": 10,
    "satellite_interpolation_mode": "lagrange",
    "satellite_clock_interpolation_mode": "linear",
    "signal_priorities": {
      "GPS": "WCSLXPYMIQ",
      "Galileo": "CBXIQ",
      "BeiDou": "IDPXQZ",
      "GLONASS": "PCX"
    }
  },

  "files": {
    "internal_data_root": "./data",
    //"observation_path": "C:/GnssProcessor/data/rinex/debug/GCGO00USA_R_20241290000_01D_30S_MO.rnx" // A 1-hour RINEX file
    "observation_path": "C:/GnssProcessor/data/2024-129/obs/gcgo00usa/GCGO00USA_R_20241290000_01D_30S_MO.rnx" // GCGO 24-hour RINEX file
    //"observation_path": "C:/GnssProcessorSupport/rinex/30S/daily/AMC400USA_R_20241290000_01D_30S_MO.rnx" // AMC4 24-hour RINEX file
    //"observation_path": "C:/GnssProcessorSupport/rinex/30S/daily/P38900USA_R_20241300000_01D_30S_MO.rnx" // P389 24-hour RINEX file
  },

  "estimation": {
    "estimate_velocity": false,
    "estimate_sat_biases": true,
    "estimate_ifb": true,
    "glonass_ifb": { "enable": true },
    "between_satellite_sd": {
      "enabled": true,
      "enable_glonass": true,
      "pivot_min_elevation": 30.0
    },
    //"ambiguity_resolution": { "mode": 0 },
    "ambiguity_resolution": {
      "mode": 1,
      "ratio_threshold": 5.0,
      "ratio_upper_bound": 1e4,
      "elevation_mask": 25.0,
      "min_epochs": 10,
      "max_position_sigma_m": 0.05
    },
    "residual_history": { "enabled": true },
    // Adaptive ionospheric process noise: scales filter.process_noise.ionosphere_q
    // per-satellite from geometry-free (L1-L2) phase second-difference variability.
    // Off by default; when off the static ionosphere_q is used unchanged.
    "adaptive_iono_process_noise": {
      "enable": false,
      "recent_window": 20,
      "baseline_window": 240,
      "max_multiplier": 100.0,
      "min_epochs": 30,
      "trace": false
    }
  },

  "filter": {
    "process_noise": {
      "position_q": 1e2,
      "acceleration_psd_q": 1e0,
      "clock_bias_q": 1e3,
      "phase_clock_q": 1e-9,
      "troposphere_q": 1e-9,
      "ionosphere_q": 1e-3,
      "code_bias_q": 1e-4,
      "sat_bias_q": 1e-12,
      "system_time_offset_q": 1e-12,
      "tropo_gradient_q": 5e-12,
      "ambiguity_q": 1e-12
    },
    "initial_std": {
      "position": 100.0,
      "velocity": 100.0,
      "clock": 1000.0,
      "troposphere": 0.5,
      "ionosphere": 5.0,
      "ambiguity": 1000.0,
      "code_bias": 10.0,
      "sat_bias": 10.0,
      "system_time_offset": 1000.0,
      "tropo_gradient": 0.001
    },
    "measurement_noise": {
      "code_std_m": 0.300,
      "phase_std_m": 0.002,
      "doppler_std_m": 0.500
    },
    //"phase_elevation_power": 1.0,
    "stochastic_model": "elevation"
  },

  "model_corrections": {
    "enable_troposphere": true,
    "enable_relativistic_correction": true,
    "enable_shapiro_delay": true,
    "enable_solid_earth_tide": true,
    "enable_ocean_tide_loading": true,
    "enable_pole_tide": true,
    "enable_atmospheric_loading": true,
    "enable_satellite_pco": true,
    "enable_satellite_pcv": true,
    "enable_receiver_pco": true,
    "enable_receiver_pcv": true,
    "enable_phase_windup": true,
    "enable_code_phase_bias": true
  },

  "data_download": {
    "enabled": true,
    "data_root": "C:/GnssProcessorSupport/products",
    "product_source": "COD",
    "product_type": "FIN",
    "station": "GCGO",
    "station_country": "USA",
    "year": 2025,
    "doy": 200,
    "download_rinex": true,
    "download_products": true,
    "atx_path": "C:/GnssProcessorSupport/products/atx/igs20.atx",
    "nc_path": "C:/GnssProcessorSupport/products/nc/EOT20_load.nc",
    "crx2rnx_path": "C:/GnssProcessorSupport/exe/crx2rnx.exe",
    "keep_zip_after_unzip": false
  },

  "logging": {
    "enable_main_log": true,
    "enable_state_trace": true,
    "enable_residual_trace": true,
    "enable_windup_trace": true,
    "enable_kalman_filter": true,
    "enable_bssd_pivot_manager": true,
    "enable_state_manager": true,
    "levels": {
      "kalman_filter": "warn",
      "bssd_pivot_manager": "info",
      "state_manager": "info"
    }
  }
}
