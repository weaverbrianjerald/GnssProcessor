// PPP-RTK
{
  "app_mode": "post",
  "data_source": "production",

  "processing": {
    "mode": "PPP-RTK",
    "active_systems": [ "GPS", "Galileo" ],
    "signal_mode": "dual",
    "elevation_mask_deg": 10.0,
    "leap_seconds_tai": 37.0,
    "relinearize_geometry": true,
    "eigen_threads": 10,
    "satellite_interpolation_mode": "lagrange",
    "satellite_clock_interpolation_mode": "linear",
    "signal_priorities": {
      "GPS": "WCSLXPYMIQ",
      "Galileo": "CBXIQ",
      "BeiDou": "IDPXQZ"
    }
  },

  "files": {
    "internal_data_root": "./data"
  },

  "estimation": {
    "estimate_velocity": false,
    "estimate_sat_biases": true,
    "between_satellite_sd": {
      "enabled": true,
      "pivot_min_elevation": 30.0
    },
    "ambiguity_resolution": { "mode": 0 },
    "residual_history": { "enabled": true }
  },

  "filter": {
    "process_noise": {
      // Kinematic: position random walk + velocity state.
      "position_q": 1e2,
      "velocity_q": 1e0,
      "clock_bias_q": 1e3,
      "phase_clock_q": 1e-9,
      "troposphere_q": 1e-9,
      "ionosphere_q": 1e-2,
      "code_bias_q": 1e-4,
      "sat_bias_q": 1e-10,
      "system_time_offset_q": 1e-12,
      "tropo_gradient_q": 5e-12,
      "ambiguity_q": 1e-12
    },
    "initial_std": {
      "position": 100.0,
      "velocity": 100.0,
      "clock": 1000.0,
      "troposphere": 0.5,
      "ionosphere": 5.0,
      "ambiguity": 1000.0,
      "code_bias": 10.0,
      "sat_bias": 10.0,
      "system_time_offset": 1000.0,
      "tropo_gradient": 0.001
    },
    "measurement_noise": {
      "code_std_m": 0.300,
      "phase_std_m": 0.001,
      "doppler_std_m": 0.500
    },
    "phase_elevation_power": 1.0,
    "stochastic_model": "satellite_block"
  },

  "model_corrections": {
    "enable_troposphere": true,
    "enable_relativistic_correction": true,
    "enable_shapiro_delay": true,
    "enable_solid_earth_tide": true,
    "enable_ocean_tide_loading": true,
    "enable_pole_tide": true,
    "enable_atmospheric_loading": true,
    "enable_satellite_pco": true,
    "enable_satellite_pcv": true,
    "enable_receiver_pco": true,
    "enable_receiver_pcv": true,
    "enable_phase_windup": true,
    "enable_code_phase_bias": true
  },

  "data_download": {
    "enabled": true,
    "data_root": "C:/GnssProcessorSupport/products",
    "product_source": "COD",
    "product_type": "FIN",
    "station": "GCGO",
    "station_country": "USA",
    "year": 2025,
    "doy": 200,
    "download_rinex": true,
    "download_products": true,
    "atx_path": "C:/GnssProcessorSupport/products/atx/igs20.atx",
    "nc_path": "C:/GnssProcessorSupport/products/nc/EOT20_load.nc",
    "crx2rnx_path": "C:/GnssProcessorSupport/exe/crx2rnx.exe",
    "keep_zip_after_unzip": false
  },

  "logging": {
    "enable_main_log": true,
    "enable_state_trace": true,
    "enable_residual_trace": true,
    "enable_kalman_filter": true,
    "levels": {
      "kalman_filter": "warn"
    }
  }
}
