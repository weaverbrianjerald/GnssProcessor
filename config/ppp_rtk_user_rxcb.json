// PPP-RTK USER (undifferenced) — receiver code-bias + GIM iono-constraint validation.
//
// This is the "PPP-RTK user consumer" half of the receiver-code-bias work:
//   - between_satellite_sd.enabled = false  -> DifferencingMode::None (undifferenced).
//     Receiver code bias only EXISTS undifferenced; under BSSD the receiver-common
//     DCB/IFB cancels in the between-satellite difference (BssdTransform zeroes it),
//     so an explicit rx code-bias state is meaningful only here.
//   - estimate_ifb = true                    -> explicit receiver DCB/IFB states
//     (GPS_DCB/GAL_DCB on the reference pair, *_IFB<band> on the rest).
//   - ionosphere_weighting.enable = true     -> GIM soft constraint (applyGimIonoUpdate)
//     anchors the per-sat slant iono's between-satellite structure, so the rx DCB
//     becomes the clean common-mode absorber instead of being buried in the iono.
//
// Precise SP3/CLK + .BIA + GIM (COD 2024-129) come from the bundled internal fixture.
{
  "app_mode": "post",
  "data_source": "internal",

  "processing": {
    "mode": "PPP-RTK",
    "active_systems": [ "GPS", "Galileo" ],
    "frequency_mode": "all",
    "channel_mode": "all",
    "elevation_mask_deg": 10.0,
    "exclude_eclipsing_satellites": true,
    "eclipse_shadow_scale": 1.0,
    "leap_seconds_tai": 37.0,
    "relinearize_geometry": true,
    "eigen_threads": 10,
    "max_duration_s": 3600.0,
    "satellite_interpolation_mode": "lagrange",
    "satellite_clock_interpolation_mode": "linear",
    "signal_priorities": {
      "GPS": "WCSLXPYMIQ",
      "Galileo": "CBXIQ",
      "BeiDou": "IDPXQZ",
      "GLONASS": "PCX"
    }
  },

  "files": {
    "internal_data_root": "./data",
    "observation_path": "C:/GnssProcessor/data/2024-129/obs/jplm00usa/JPLM00USA_R_20241290000_01D_30S_MO.rnx"
  },

  "estimation": {
    "estimate_velocity": false,
    "estimate_sat_biases": true,
    "estimate_ifb": true,
    "between_satellite_sd": {
      "enabled": false
    },
    "ambiguity_resolution": { "mode": 0 },
    "ionosphere_weighting": {
      "enable": true,
      "common_mode_sigma_m": 50.0,
      "std_scale": 1.0,
      "floor_m": 0.05,
      "elevation_cutoff_deg": 10.0
    },
    "residual_history": { "enabled": true },
    "adaptive_iono_process_noise": { "enable": false }
  },

  "filter": {
    "process_noise": {
      "position_q": 1e2,
      "acceleration_psd_q": 1e0,
      "clock_bias_q": 1e3,
      "phase_clock_q": 1e-9,
      "troposphere_q": 1e-9,
      "ionosphere_q": 1e-3,
      "code_bias_q": 1e-4,
      "sat_bias_q": 1e-12,
      "system_time_offset_q": 1e-12,
      "tropo_gradient_q": 5e-12,
      "ambiguity_q": 1e-12
    },
    "initial_std": {
      "position": 100.0,
      "velocity": 100.0,
      "clock": 1000.0,
      "troposphere": 0.5,
      "ionosphere": 5.0,
      "ambiguity": 1000.0,
      "code_bias": 10.0,
      "sat_bias": 10.0,
      "system_time_offset": 1000.0,
      "tropo_gradient": 0.001
    },
    "measurement_noise": {
      "code_std_m": 0.300,
      "phase_std_m": 0.002,
      "doppler_std_m": 0.500
    },
    "stochastic_model": "elevation"
  },

  "model_corrections": {
    "enable_troposphere": true,
    "enable_relativistic_correction": true,
    "enable_shapiro_delay": true,
    "enable_solid_earth_tide": true,
    "enable_ocean_tide_loading": true,
    "enable_pole_tide": true,
    "enable_atmospheric_loading": false,
    "enable_satellite_pco": true,
    "enable_satellite_pcv": true,
    "enable_receiver_pco": true,
    "enable_receiver_pcv": true,
    "enable_phase_windup": true,
    "enable_code_phase_bias": true
  },

  "data_download": {
    "enabled": false,
    "data_root": "C:/GnssProcessorSupport/products",
    "product_source": "COD",
    "product_type": "FIN",
    "station": "JPLM",
    "station_country": "USA",
    "year": 2024,
    "doy": 129,
    "download_rinex": false,
    "download_products": false,
    "atx_path": "C:/GnssProcessorSupport/products/atx/igs20.atx",
    "nc_path": "C:/GnssProcessorSupport/products/nc/EOT20_load.nc",
    "crx2rnx_path": "C:/GnssProcessorSupport/exe/crx2rnx.exe",
    "keep_zip_after_unzip": false
  },

  "logging": {
    "enable_main_log": true,
    "enable_state_trace": true,
    "enable_code_bias_trace": true,
    "enable_residual_trace": true,
    "enable_kalman_filter": true,
    "enable_state_manager": true,
    "levels": {
      "kalman_filter": "warn",
      "state_manager": "info",
      "ionosphere": "debug"
    }
  }
}
