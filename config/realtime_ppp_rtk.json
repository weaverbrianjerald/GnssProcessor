// Real-time PPP-RTK with IGS-RTS SSR corrections.
//
// Two concurrent RTCM streams:
//   - Primary  : rover observations (file replay for now; eventually
//                a Septentrio TCP/serial output of MSM7 messages once
//                the MSM decoder lands).
//   - corrections : IGS-RTS legacy SSR (1057-1068, 1240-1270) over NTRIP.
//                   IGS-SSR 4076 sub-types are recognised by the parser
//                   but not yet fully decoded — coming in a follow-up.
//
// Replace the host/mountpoint/credentials with your IGS-IP account
// (https://igs.bkg.bund.de/ntrip/ntriplogin or equivalent provider).
{
  "app_mode": "real_time",
  "data_source": "internal",

  "processing": {
    "mode": "PPP-RTK",
    "active_systems": [ "GPS", "Galileo", "BeiDou" ],
    "signal_mode": "all",
    "elevation_mask_deg": 10.0,
    "leap_seconds_tai": 37.0,
    "satellite_interpolation_mode": "lagrange",
    "satellite_clock_interpolation_mode": "linear",
    "signal_priorities": {
      "GPS":     "WCSLXPYMIQ",
      "Galileo": "CBXIQ",
      "GLONASS": "CPIXQ",
      "BeiDou":  "IDPXQZ",
      "QZSS":    "CSLXIQDEX",
      "SBAS":    "CXIQ"
    }
  },

  // Static products (broadcast nav, ATX, EOT) loaded at startup.  The
  // SSR overlay corrects the BROADCAST orbits/clocks at query time —
  // so this section still needs valid broadcast-nav / ATX paths.
  "files": {
    "internal_data_root": "./data"
  },

  "realtime": {
    // Primary stream: rover observations.  input_type selects the
    // transport.  Three options:
    //   "file"  — replay an RTCM3 dump (input_path).
    //   "ntrip" — pull from a caster (ntrip_host/port/mountpoint).
    //   "tcp"   — direct socket to a receiver, e.g. a Septentrio
    //             configured to push RTCMv3 to "IPS1, port 28784".
    //             No NTRIP wrapper, no auth — raw bytes only.
    "input_type":      "file",
    "input_path":      "C:/GnssProcessor/data/rtcm/rover_obs.rtcm3",

    // For input_type="tcp" — Septentrio rooftop direct connection example:
    "tcp_host":        "rooftop.local",
    "tcp_port":        28784,

    // Optional NTRIP fields (used when input_type="ntrip").
    "ntrip_host":      "",
    "ntrip_port":      2101,
    "ntrip_mountpoint":"",
    "ntrip_user":      "",
    "ntrip_password":  "",

    // Output and reconnect knobs.
    "output_type":     "console",
    "reconnect_delay_s": 5,

    // Second stream: SSR corrections from an IGS-RTS caster.  Set
    // enabled=true to activate; the realtime engine will spin up a
    // separate NtripClient thread alongside the primary one and route
    // decoded SSR records into SsrCorrectionStore.
    "corrections": {
      "enabled":          false,
      "input_type":       "ntrip",
      "ntrip_host":       "products.igs-ip.net",
      "ntrip_port":       2101,
      "ntrip_mountpoint": "IGS01",
      "ntrip_user":       "",
      "ntrip_password":   "",
      "reconnect_delay_s": 5,

      // For replay testing: dump a few minutes of an IGS-RTS feed to
      // a binary file and switch input_type to "file".
      "input_path":       "",

      // For input_type="tcp" — e.g. a relay box that proxies the IGS-RTS
      // stream to a local TCP port.
      "tcp_host":         "",
      "tcp_port":         28785
    }
  },

  "estimation": {
    "between_satellite_sd": {
      "enabled": true,
      "pivot_min_elevation": 25.0
    },
    "ambiguity_resolution": {
      "mode": 0,
      "ratio_threshold": 3.0,
      "elevation_mask": 20.0,
      "hold_variance": 0.001
    }
  },

  "filter": {
    "process_noise": {
      "position_q": 0.0,
      "clock_bias_q": 1e3,
      "phase_clock_q": 1e-9,
      "troposphere_q": 1e-8,
      "ionosphere_q": 0.03,
      "code_bias_q": 1e-4,
      "sat_bias_q": 1e-10,
      "system_time_offset_q": 1e-12,
      "tropo_gradient_q": 5e-12,
      "velocity_q": 1e2
    },
    "initial_std": {
      "position": 30.0,
      "velocity": 100.0,
      "clock": 1000.0,
      "troposphere": 0.5,
      "ionosphere": 5.0,
      "ambiguity": 100.0,
      "code_bias": 10.0,
      "sat_bias": 10.0,
      "system_time_offset": 1000.0,
      "tropo_gradient": 0.001
    },
    "measurement_noise": {
      "code_std_m": 0.300,
      "phase_std_m": 0.001,
      "doppler_std_m": 0.5
    },
    "stochastic_model": "satellite_block"
  },

  "model_corrections": {
    "enable_troposphere": true,
    "enable_relativistic_correction": true,
    "enable_shapiro_delay": true,
    "enable_solid_earth_tide": true,
    "enable_ocean_tide_loading": false,
    "enable_pole_tide": true,
    "enable_atmospheric_loading": false,
    "enable_satellite_pco": true,
    "enable_satellite_pcv": true,
    "enable_receiver_pco": true,
    "enable_receiver_pcv": true,
    "enable_phase_windup": true,
    "enable_code_phase_bias": true
  },

  "data_download": {
    "enabled": false,
    "data_root": "C:/GnssProcessorSupport/products",
    "atx_path":  "C:/GnssProcessorSupport/products/atx/igs20.atx",
    "nc_path":   "C:/GnssProcessorSupport/products/nc/EOT20_load.nc"
  },

  "logging": {
    "enable_main_log": true,
    "enable_state_trace": true,
    "enable_residual_trace": true
  }
}
