// PPP-RTK NETWORK producer — GPS + Galileo + GLONASS (code-only GLONASS).
//
// Same minimum-constraint S-system joint estimator as ppp_rtk_network_internal.json,
// but with GLONASS ADMITTED to the network (network.estimate_glonass=true).
//
// GLONASS scope = CODE-ONLY: it contributes a per-satellite shared CLOCK product;
// the FDMA receiver group delay is carried by the per-FCN-slot receiver IFB as a
// LOCAL nuisance (Schur-eliminated, never emitted); NO GLONASS satellite phase bias
// is produced (a single shared per-(sat,signal) phase bias is unphysical for FDMA).
// network.estimate_glonass forces estimate_ifb + glonass_ifb.enable on and requires
// GLONASS in active_systems (its observations would otherwise pin the receiver clock
// and corrupt the GPS/Galileo products).
//
// Only the FDMA bands G1/G2 participate (per-slot IFB territory): the GLONASS
// signal-priority string "CP" matches the C/P attributes that exist on bands 1 and 2
// and excludes the G3 (C3Q) CDMA band, which has no per-slot IFB model in V1.
//
// Three continental-scale IGS stations from the bundled 2024-129 fixture (all track
// GLONASS); JPLM is the clock datum (network-time reference receiver).
{
  "app_mode": "post",
  "data_source": "internal",

  "processing": {
    "mode": "ppp-rtk-network",
    "active_systems": [ "GPS", "Galileo", "GLONASS" ],
    "frequency_mode": "all",
    "channel_mode": "all",
    "elevation_mask_deg": 10.0,
    "exclude_eclipsing_satellites": true,
    "leap_seconds_tai": 37.0,
    "relinearize_geometry": false,
    "eigen_threads": 10,
    "max_duration_s": 3600.0,
    "satellite_interpolation_mode": "lagrange",
    "satellite_clock_interpolation_mode": "linear",
    "signal_priorities": {
      "GPS": "WCSLXPYMIQ",
      "Galileo": "CBXIQ",
      // GLONASS FDMA bands G1/G2 only (C/P attributes). G3 (C3Q) excluded —
      // it is CDMA and has no per-FCN-slot IFB model in V1.
      "GLONASS": "CP"
    }
  },

  "files": {
    "internal_data_root": "./data",
    "observation_path": "C:/GnssProcessor/data/2024-129/obs/jplm00usa/JPLM00USA_R_20241290000_01D_30S_MO.rnx"
  },

  "estimation": {
    "estimate_velocity": false,
    "estimate_phase_clock": false,
    // estimate_ifb + glonass_ifb.enable are FORCED on by network.estimate_glonass;
    // set explicitly here for clarity.
    "estimate_ifb": true,
    "glonass_ifb": { "enable": true },
    "estimate_sat_biases": false,
    "no_bia_code_downweight": 1.0,
    "between_satellite_sd": { "enabled": false },
    "ambiguity_resolution": {
      "mode": 0,
      "wl_only": true,
      "active_systems": [ "GPS" ],
      "ratio_threshold": 3.0,
      "ratio_upper_bound": 1e4,
      "min_success_rate": 0.999,
      "nl_max_per_pair_frac": 0.15,
      "elevation_mask": 25.0,
      "min_epochs": 1,
      "max_position_sigma_m": 10.0,
      "hold_variance": 0.001,
      "wl_max_frac": 0.40
    },
    "adaptive_iono_process_noise": { "enable": false }
  },

  "filter": {
    "process_noise": {
      "position_q": 1e2,
      "clock_bias_q": 1e3,
      "phase_clock_q": 1e-9,
      "troposphere_q": 1e-9,
      "ionosphere_q": 1e-3,
      "code_bias_q": 1e-4,
      "sat_bias_q": 1e-12,
      "sat_phase_bias_q": 1e-12,
      "sat_clock_q": 1e-2,
      "system_time_offset_q": 1e-12,
      "ambiguity_q": 1e-12
    },
    "initial_std": {
      "position": 100.0,
      "clock": 1000.0,
      "troposphere": 0.5,
      "ionosphere": 5.0,
      "ambiguity": 1000.0,
      "code_bias": 10.0,
      "sat_bias": 10.0,
      "sat_phase_bias": 10.0,
      "sat_clock": 1000.0,
      "system_time_offset": 1000.0
    },
    "measurement_noise": {
      "code_std_m": 0.300,
      "phase_std_m": 0.002
    },
    "stochastic_model": "elevation"
  },

  "model_corrections": {
    "enable_troposphere": true,
    "enable_relativistic_correction": true,
    "enable_shapiro_delay": true,
    "enable_solid_earth_tide": true,
    "enable_ocean_tide_loading": false,
    "enable_pole_tide": true,
    "enable_atmospheric_loading": false,
    "enable_satellite_pco": true,
    "enable_satellite_pcv": true,
    "enable_receiver_pco": true,
    "enable_receiver_pcv": true,
    "enable_phase_windup": true,
    "enable_higher_order_ionosphere": false,
    "enable_code_phase_bias": true
  },

  "network": {
    "clock_datum_station": "JPLM00USA",
    "epoch_sync_tolerance_s": 1.0,
    // Admit GLONASS to the network product (code-only: sat clock + per-slot rx IFB).
    "estimate_glonass": true,
    "product_output_path": "network_products_glonass.txt",
    "stations": [
      {
        "name": "JPLM00USA",
        "rinex_path": "C:/GnssProcessor/data/2024-129/obs/jplm00usa/JPLM00USA_R_20241290000_01D_30S_MO.rnx",
        "position_ecef": [ -2493304.9886, -4655214.7866, 3565497.6745 ]
      },
      {
        "name": "P38900USA",
        "rinex_path": "C:/GnssProcessor/data/2024-129/obs/p38900usa/P38900USA_R_20241290000_01D_15S_MO.rnx",
        "position_ecef": [ -2347409.5144, -3968716.0159, 4394004.5932 ]
      },
      {
        "name": "GCGO00USA",
        "rinex_path": "C:/GnssProcessor/data/2024-129/obs/gcgo00usa/GCGO00USA_R_20241290000_01D_30S_MO.rnx",
        "position_ecef": [ -2281621.7499, -1453585.0819, 5756964.8917 ]
      }
    ],

    // GPS-only held-out consumer (RINEX-2): validates that adding GLONASS to the
    // producer does not regress the GPS clock + phase-bias product.  The consumer
    // does not consume GLONASS (ar_active_systems = GPS).
    "closed_loop": {
      "enable": true,
      "consumer_undifferenced": true,
      "consume_network_products": true,
      "consume_network_clock": false,
      "ar_mode": 1,
      "ar_wl_only": false,
      "ar_active_systems": [ "GPS" ],
      "station": {
        "name": "CIT100USA",
        "rinex_path": "C:/GnssProcessor/data/2024-129/obs/cit1/cit11290.24o",
        "position_ecef": [ -2491490.7172, -4660802.8495, 3559129.1872 ]
      }
    }
  },

  "data_download": {
    "enabled": false,
    "product_source": "COD",
    "product_type": "FIN",
    "year": 2024,
    "doy": 129
  },

  "logging": {
    "enable_main_log": true,
    "enable_ambiguity_resolver": true,
    "enable_state_trace": true,
    "enable_ambiguity_trace": true,
    "enable_residual_trace": true,
    "enable_dop_trace": true,
    "enable_sat_status_trace": true,
    "levels": {
      "measurement_model": "warn",
      "state_manager": "warn",
      "state_initializer": "warn",
      "ppp_model": "warn",
      "kalman_filter": "warn",
      "ambiguity_resolver": "info"
    }
  }
}
