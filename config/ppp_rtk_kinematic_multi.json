// PPP-RTK, GPS+Galileo+BeiDou, kinematic, internal auto-discovery.
// Tests: uncombined multi-system PPP-RTK with BSSD pivots, position
//        random walk + velocity state.  Underlying GCGO data is
//        static — this exercises the kinematic state schema only.
{
  "app_mode": "post",
  "data_source": "internal",

  "processing": {
    "mode": "PPP-RTK",
    "active_systems": [ "GPS", "Galileo", "BeiDou" ],
    "frequency_mode": "all",
    "channel_mode": "all",
    "elevation_mask_deg": 10.0,
    "exclude_eclipsing_satellites": true,
    "eclipse_shadow_scale": 1.0,
    "leap_seconds_tai": 37.0,
    "rinex_types": "CLD", // retain Doppler for estimate_velocity
    "relinearize_geometry": true,
    "eigen_threads": 10,
    "satellite_interpolation_mode": "lagrange",
    "satellite_clock_interpolation_mode": "linear",
    "signal_priorities": {
      "GPS":     "WCSLXPYMIQ",
      "Galileo": "CBXIQ",
      "BeiDou":  "IDPXQZ"
    }
  },

  "files": {
    "internal_data_root": "./data"
  },

  "estimation": {
    "estimate_velocity": true,
    "estimate_sat_biases": true,
    "between_satellite_sd": {
      "enabled": true,
      "pivot_min_elevation": 30.0
    },
    "ambiguity_resolution": { "mode": 0 }
  },

  "filter": {
    "process_noise": {
      // Kinematic: CWNA position+velocity process model.
      "position_q":            1e2,
      "acceleration_psd_q":    1e0,
      "clock_bias_q":          1e3,
      "phase_clock_q":         1e-9,
      "troposphere_q":         1e-8,
      "ionosphere_q":          0.03,
      "code_bias_q":           1e-4,
      "sat_bias_q":            1e-10,
      "system_time_offset_q":  1e-12,
      "tropo_gradient_q":      5e-12
    },
    "initial_std": {
      "position":           100.0,
      "velocity":           100.0,
      "clock":             1000.0,
      "troposphere":         0.5,
      "ionosphere":          5.0,
      "ambiguity":         100.0,
      "code_bias":          10.0,
      "sat_bias":           10.0,
      "system_time_offset":1000.0,
      "tropo_gradient":     0.001
    },
    "measurement_noise": {
      "code_std_m":   0.300,
      "phase_std_m":  0.001,
      "doppler_std_m":0.500
    },
    "stochastic_model": "satellite_block"
  },

  "model_corrections": {
    "enable_troposphere": true,
    "enable_relativistic_correction": true,
    "enable_shapiro_delay": true,
    "enable_solid_earth_tide": true,
    "enable_ocean_tide_loading": true,
    "enable_pole_tide": true,
    "enable_atmospheric_loading": false,
    "enable_satellite_pco": true,
    "enable_satellite_pcv": true,
    "enable_receiver_pco": true,
    "enable_receiver_pcv": true,
    "enable_phase_windup": true,
    "enable_code_phase_bias": true
  },

  "data_download": {
    "enabled": false,
    "year": 2024, "doy": 129,
    "station": "GCGO", "station_country": "USA",
    "atx_path": "C:/GnssProcessorSupport/products/atx/igs20.atx",
    "nc_path":  "C:/GnssProcessorSupport/products/nc/EOT20_load.nc"
  },

  "logging": {
    "enable_main_log": true,
    "enable_state_trace": true,
    "enable_residual_trace": true
  }
}
