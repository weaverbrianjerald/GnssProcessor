// Baseline-Multi (DD star), GPS+Galileo, static.
// Tests: multi-rover star topology — one reference, N rovers,
//        each rover DD'd independently against the reference.
//
// Geometry note: the available IGS data only has one short-baseline
// rover near CIT1 (JPLM, ~10 km).  GCGO is included as a SECOND
// rover at ~3500 km (long baseline) so the schema is exercised end
// to end; expect long-baseline differential ionosphere/troposphere
// to dominate that rover's residuals unless use_iono_free=true and
// estimate_differential_tropo=true are set.  Replace the GCGO entry
// with a real second short-baseline station once available.
{
  "app_mode": "post",
  "data_source": "internal",

  "processing": {
    "mode": "Baseline-Multi",
    "active_systems": [ "GPS", "Galileo" ],
    "signal_mode": "dual",
    "elevation_mask_deg": 10.0,
    "leap_seconds_tai": 37.0,
    "relinearize_geometry": true,
    "eigen_threads": 10,
    "satellite_interpolation_mode": "lagrange",
    "satellite_clock_interpolation_mode": "linear",
    "signal_priorities": {
      "GPS":     "WCSLXPYMIQ",
      "Galileo": "CBXIQ"
    }
  },

  "files": {
    "internal_data_root": "./data"
  },

  "baseline": {
    "reference": {
      "name": "CIT100USA",
      // Caltech ITRF2014 ECEF (m).  Required for a fixed reference.
      "position_ecef": [ -2492066.660, -4655842.330, 3565461.180 ],
      "fixed": true
    },
    "rovers": [
      { "name": "JPLM00USA" },
      { "name": "GCGO00USA" }
    ],
    "max_baseline_km":            5000.0,
    "epoch_sync_tolerance_s":     0.01,
    "signal_aliasing":            true,
    "enable_pivot_handover":      true,
    // Enable differential troposphere + IF combination when running
    // the second (long-baseline) rover; see file header.
    "estimate_differential_tropo": false,
    "use_iono_free":              false
  },

  "estimation": {
    "estimate_velocity": false,
    "ambiguity_resolution": { "mode": 0 }
  },

  "filter": {
    "process_noise": {
      "position_q":     1e2,
      "troposphere_q":  1e-8
    },
    "initial_std": {
      "position":      100.0,
      "troposphere":     0.5,
      "ambiguity":     100.0
    },
    "measurement_noise": {
      "code_std_m":  0.300,
      "phase_std_m": 0.001
    },
    "stochastic_model": "satellite_block"
  },

  "model_corrections": {
    "enable_troposphere": true,
    "enable_solid_earth_tide": true,
    "enable_pole_tide": true,
    "enable_satellite_pco": true,
    "enable_satellite_pcv": true,
    "enable_receiver_pco": true,
    "enable_receiver_pcv": true,
    "enable_phase_windup": true
  },

  "data_download": {
    "enabled": false,
    "year": 2024, "doy": 129,
    "atx_path": "C:/GnssProcessorSupport/products/atx/igs20.atx"
  },

  "logging": {
    "enable_main_log": true,
    "enable_state_trace": true,
    "enable_residual_trace": true
  }
}
