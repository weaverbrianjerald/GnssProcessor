// PPP, GPS+Galileo, kinematic, production-mode auto-download.
// Tests: full production data fetch for a fresh date the local
//        cache has never seen (CIT1, 2025-DOY200), exercising
//        ProductResolver downloads for SP3/CLK/BIA/ERP/BRDC plus
//        Hatanaka .crx.gz → crx2rnx → ready .rnx for the obs file.
//        Re-running hits the new phase-0 short-circuit and skips
//        every download / conversion that already produced output.
{
  "app_mode": "post",
  "data_source": "production",

  "processing": {
    "mode": "PPP",
    "active_systems": [ "GPS", "Galileo" ],
    "signal_mode": "dual",
    "elevation_mask_deg": 10.0,
    "leap_seconds_tai": 37.0,
    "relinearize_geometry": true,
    "eigen_threads": 10,
    "satellite_interpolation_mode": "lagrange",
    "satellite_clock_interpolation_mode": "linear"
  },

  "files": {
    // observation_path / navigation_path empty — ProductResolver
    // downloads them and PathResolver wires the resulting paths
    // into the config.
  },

  "estimation": {
    "estimate_velocity": true,
    "estimate_sat_biases": false,
    "between_satellite_sd": { "enabled": false },
    "ambiguity_resolution": { "mode": 0 }
  },

  "filter": {
    "process_noise": {
      // Kinematic: position_q ~m^2/s allows the filter to track
      // motion; velocity_q is the random-walk on the velocity state.
      "position_q":            1e2,
      "velocity_q":            1e0,
      "clock_bias_q":          1e3,
      "troposphere_q":         1e-8,
      "ionosphere_q":          0.03,
      "system_time_offset_q":  1e-12
    },
    "initial_std": {
      "position":            100.0,
      "velocity":            100.0,
      "clock":              1000.0,
      "troposphere":          0.5,
      "ionosphere":           5.0,
      "ambiguity":          100.0,
      "system_time_offset": 1000.0
    },
    "measurement_noise": {
      "code_std_m":   0.300,
      "phase_std_m":  0.001,
      "doppler_std_m":0.500
    },
    "stochastic_model": "satellite_block"
  },

  "model_corrections": {
    "enable_troposphere": true,
    "enable_relativistic_correction": true,
    "enable_shapiro_delay": true,
    "enable_solid_earth_tide": true,
    "enable_ocean_tide_loading": true,
    "enable_pole_tide": true,
    "enable_atmospheric_loading": true,
    "enable_satellite_pco": true,
    "enable_satellite_pcv": true,
    "enable_receiver_pco": true,
    "enable_receiver_pcv": true,
    "enable_phase_windup": true,
    "enable_code_phase_bias": true
  },

  "data_download": {
    "enabled":           true,
    "data_root":         "C:/GnssProcessorSupport/products",
    "product_source":    "COD",
    "product_type":      "FIN",
    "station":           "CIT1",
    "station_country":   "USA",
    "year":              2025,
    "doy":               200,
    "download_rinex":    true,
    "download_products": true,
    "atx_path":          "C:/GnssProcessorSupport/products/atx/igs20.atx",
    "nc_path":           "C:/GnssProcessorSupport/products/nc/EOT20_load.nc",
    "crx2rnx_path":      "C:/GnssProcessorSupport/exe/crx2rnx.exe",
    "keep_zip_after_unzip": false
  },

  "logging": {
    "enable_main_log": true,
    "enable_state_trace": true,
    "enable_residual_trace": true
  }
}
