{
 "_comment": "OFF-path byte-cert of the QUEUE-8b iono-carry build: _camp60_f4.json verbatim (new knobs absent), products compared byte-exact vs runs/camp60_f4.",
 "app_mode": "post",
 "data_source": "internal",
 "processing": {
  "mode": "ppp-rtk-network",
  "active_systems": [
   "GPS",
   "Galileo"
  ],
  "frequency_mode": "triple",
  "channel_mode": "all",
  "elevation_mask_deg": 10.0,
  "exclude_eclipsing_satellites": true,
  "leap_seconds_tai": 37.0,
  "relinearize_geometry": false,
  "eigen_threads": 10,
  "max_duration_s": 21900.0,
  "satellite_interpolation_mode": "lagrange",
  "satellite_clock_interpolation_mode": "linear",
  "signal_priorities": {
   "GPS": [
    "C1C",
    "L1C",
    "C2W",
    "L2W",
    "C5Q",
    "L5Q"
   ],
   "Galileo": [
    "C1C",
    "L1C",
    "C5Q",
    "L5Q",
    "C7Q",
    "L7Q"
   ]
  }
 },
 "files": {
  "internal_data_root": "./data"
 },
 "model_corrections": {
  "enable_troposphere": true,
  "enable_relativistic_correction": true,
  "enable_shapiro_delay": true,
  "enable_solid_earth_tide": true,
  "enable_ocean_tide_loading": false,
  "enable_pole_tide": true,
  "enable_atmospheric_loading": false,
  "enable_satellite_pco": true,
  "enable_satellite_pcv": true,
  "enable_receiver_pco": true,
  "enable_receiver_pcv": true,
  "enable_phase_windup": true,
  "enable_higher_order_ionosphere": false,
  "enable_code_phase_bias": false
 },
 "estimation": {
  "accumulate_phase_windup": true,
  "estimate_velocity": false,
  "estimate_phase_clock": false,
  "ambiguity_resolution": {
   "mode": 0
  },
  "adaptive_iono_process_noise": {
   "enable": false
  },
  "//iono": "The cutoff, NOT the enable, is the load-bearing field here \u2014 the",
  "//iono2": "enable is forced on by the W6 slice anyway.  Values other than the",
  "//iono3": "cutoff are the shipped defaults, restated so an arm cannot inherit a",
  "//iono4": "changed default silently.",
  "ionosphere_weighting": {
   "enable": false,
   "//": "enable force-armed by the W6 slice; the CUTOFF is the load-bearing field (10 is the known-bad shipped default)",
   "elevation_cutoff_deg": 25.0
  },
  "//sh": "Field-matched SH posture (_cbq305_2f_12h_d10): degree 15, single shell,",
  "//sh2": "sun-fixed, representation-error demean + d5-keep.  trace: true is what",
  "//sh3": "opens network_vtec_sh.csv (coefficients + sigma) and the per-epoch",
  "//sh4": "network_vtec_sh_health.csv (a00 + a00 sigma + per-degree rms) \u2014 the a00",
  "//sh5": "channel of the \u00a711 item 4 decomposition.  network_ionosphere.csv is NOT",
  "//sh6": "a substitute: it writes x_r alone and is frame-broken (CLAUDE.md)."
 },
 "filter": {
  "process_noise": {
   "position_q": 100.0,
   "clock_bias_q": 1000.0,
   "phase_clock_q": 1e-09,
