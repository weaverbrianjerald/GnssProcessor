        "model_corrections.enable_phase_windup": true,
        "estimation.accumulate_phase_windup": false,
        "processing.eigen_threads": 1,
        "logging.enable_windup_trace": true,
        "logging.enable_residual_trace": true } },

    { "label": "b_wu_off_frac", "base": "ppp", "overrides": {
        "model_corrections.enable_phase_windup": false,
        "estimation.accumulate_phase_windup": false,
        "processing.eigen_threads": 1,
        "logging.enable_windup_trace": true,
        "logging.enable_residual_trace": true } },

    { "label": "c_wu_on_acc", "base": "ppp", "overrides": {
        "model_corrections.enable_phase_windup": true,
        "estimation.accumulate_phase_windup": true,
        "processing.eigen_threads": 1,
        "logging.enable_windup_trace": true,
        "logging.enable_residual_trace": true } },

    { "label": "d_wu_off_acc", "base": "ppp", "overrides": {
        "model_corrections.enable_phase_windup": false,
        "estimation.accumulate_phase_windup": true,
        "processing.eigen_threads": 1,
        "logging.enable_windup_trace": true,
        "logging.enable_residual_trace": true } },

    { "label": "e_wu_on_acc_kin", "base": "ppp", "overrides": {
