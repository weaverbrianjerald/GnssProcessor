        "processing.rinex_types": "CLD",
        "filter.process_noise.position_q": 100.0,
        "filter.process_noise.acceleration_psd_q": 1.0,
        "processing.eigen_threads": 1,
        "logging.enable_windup_trace": true,
        "logging.enable_residual_trace": true } },

    { "label": "f_wu_off_acc_kin", "base": "ppp", "overrides": {
        "model_corrections.enable_phase_windup": false,
        "estimation.accumulate_phase_windup": true,
        "estimation.estimate_velocity": true,
        "processing.rinex_types": "CLD",
        "filter.process_noise.position_q": 100.0,
        "filter.process_noise.acceleration_psd_q": 1.0,
        "processing.eigen_threads": 1,
        "logging.enable_windup_trace": true,
        "logging.enable_residual_trace": true } }
  ],

  "matrix": [
    { "station": "JPLM", "cells": ["a_wu_on_frac", "b_wu_off_frac", "c_wu_on_acc", "d_wu_off_acc", "e_wu_on_acc_kin", "f_wu_off_acc_kin"] },
    { "station": "CIT1", "cells": ["a_wu_on_frac", "b_wu_off_frac", "c_wu_on_acc", "d_wu_off_acc"] },
    { "station": "GCGO", "cells": ["a_wu_on_frac", "b_wu_off_frac", "c_wu_on_acc", "d_wu_off_acc"] }
  ]
