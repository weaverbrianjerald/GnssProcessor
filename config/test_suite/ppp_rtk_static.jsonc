/// Test-suite base config: STATIC PPP-RTK (uncombined + BSSD), GPS+Galileo,
/// internal (bundled) data.  Graded against independent SINEX/SIF truth.
///
/// Float by default (ambiguity_resolution.mode = 0); the "ppp_rtk_ar" matrix
/// cell flips mode = 1 (WL-only AR).  STATIC: position_q = 0 + estimate_velocity
/// = false.  The slice/suite runner injects the per-station observation_path +
/// date hint and applies one override patch per matrix cell.
{
  "app_mode": "post",
  "data_source": "internal",

  "processing": {
    "mode": "PPP-RTK",
    "active_systems": [ "GPS", "Galileo" ],
    "frequency_mode": "all",
    "channel_mode": "all",
    "elevation_mask_deg": 10.0,
    "exclude_eclipsing_satellites": true,
    "eclipse_shadow_scale": 1.0,
    "leap_seconds_tai": 37.0,
    "relinearize_geometry": true,
    "auto_report": false,
    "eigen_threads": 10,
    "satellite_interpolation_mode": "lagrange",
    "satellite_clock_interpolation_mode": "linear",
    "signal_priorities": {
      "GPS": "WCSLXPYMIQ",
      "Galileo": "CBXIQ"
    }
  },

  "files": {
    "internal_data_root": "C:/GnssProcessor/data",
    "observation_path": "C:/GnssProcessor/data/2024-129/obs/jplm00usa/JPLM00USA_R_20241290000_01D_30S_MO.rnx"
  },

  "estimation": {
    "estimate_velocity": false,
    "estimate_sat_biases": true,
    "between_satellite_sd": {
      "enabled": true,
      "enable_glonass": false,
      "pivot_min_elevation": 30.0
    },
    "ambiguity_resolution": {
      "mode": 0,
      "wl_only": true,
      "ratio_threshold": 3.0,
      "elevation_mask": 25.0,
      "min_epochs": 10,
      "max_position_sigma_m": 0.05
    },
    "residual_history": { "enabled": false }
  },

  "filter": {
    "process_noise": {
      "position_q": 0.0,
      "acceleration_psd_q": 0.0,
      "clock_bias_q": 1e3,
      "phase_clock_q": 1e-9,
      "troposphere_q": 1e-9,
      "ionosphere_q": 1e-3,
      "code_bias_q": 1e-4,
      "sat_bias_q": 1e-12,
      "system_time_offset_q": 1e-12,
      "tropo_gradient_q": 5e-12,
      "ambiguity_q": 1e-12
    },
    "initial_std": {
      "position": 100.0,
      "velocity": 100.0,
      "clock": 1000.0,
      "troposphere": 0.5,
      "ionosphere": 5.0,
      "ambiguity": 1000.0,
      "code_bias": 10.0,
      "sat_bias": 10.0,
      "system_time_offset": 1000.0,
      "tropo_gradient": 0.001
    },
    "measurement_noise": {
      "code_std_m": 0.300,
      "phase_std_m": 0.002,
      "doppler_std_m": 0.500
    },
    "stochastic_model": "elevation"
  },

  "model_corrections": {
    "enable_troposphere": true,
    "enable_relativistic_correction": true,
    "enable_shapiro_delay": true,
    "enable_solid_earth_tide": true,
    "enable_ocean_tide_loading": true,
    "enable_pole_tide": true,
    "enable_atmospheric_loading": false,
    "enable_satellite_pco": true,
    "enable_satellite_pcv": true,
    "enable_receiver_pco": true,
    "enable_receiver_pcv": true,
    "enable_phase_windup": true,
    "enable_code_phase_bias": true
  },

  "data_download": {
    "enabled": false,
    "station": "JPLM",
    "station_country": "USA",
    "year": 2024,
    "doy": 129
  },

  "logging": {
    "enable_main_log": true,
    "enable_state_trace": true,
    "enable_residual_trace": false,
    "enable_kalman_filter": false
  }
}
