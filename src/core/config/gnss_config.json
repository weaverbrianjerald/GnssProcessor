// =====================================================================
//  GnssProcessor configuration
//
//  This file uses C/C++ style comments (// and /* */).
// =====================================================================
{
  "app_mode": "post", // post, realtime

  // =================================================================
  //  Processing
  // =================================================================
  "processing": {
    // --- Processing mode ---------------------------------------------------
    "mode": "PPP-RTK", // PPP, PPP-RTK
    //"mode": "PPP",                                // Ionosphere-free

    // --- Signal combination ------------------------------------------------
    //"uncombined_enabled": true,
    "signal_mode": "dual", // dual, triple, all
    //"mw_signals": "filter",   // filter (default: use KF bands), all (use all RINEX bands)
    "elevation_mask_deg": 10.0,
    // "data_gap_tolerance_s": 0,        // 0 = measurement rate (default)
    "leap_seconds_tai": 37.0,
    "relinearize_geometry": false,
    "satellite_interpolation_mode": "lagrange",
    "satellite_clock_interpolation_mode": "linear",
    "active_systems": [ "GPS", "Galileo" ],
    "excluded_satellites": [],
    "signal_priorities": {
      "GPS": "WCSLXPYMIQ",
      "Galileo": "CBXIQ",
      "GLONASS": "CPIXQ",
      "BeiDou": "IDPXQZ",
      "QZSS": "CSLXIQDEX",
      "SBAS": "CXIQ"
    }
  },

  // =================================================================
  //  File paths
  // =================================================================
  "files": {
    "observation_path": "C:/GnssProcessorSupport/rinex/30S/daily/GCGO00USA_R_20241290000_01D_30S_MO.rnx",
    "navigation_path": "C:/GnssProcessorSupport/products/rnx/BRDC00IGS_R_20241290000_01D_MN.rnx",
    "product_list_path": "C:/GnssProcessorSupport/products/default_products.txt"
  },

  // =================================================================
  //  Estimation toggles
  //
  //  Most toggles are derived automatically from the processing mode
  //  (PPP vs PPP-RTK) and signal mode (dual/triple/all).  Uncomment
  //  any line below to override the smart default.
  //
  //  PPP-RTK bias handling (three strategies, choose via overrides):
  //    1. lock_signals_to_clock_ref  – restrict to clock-ref bands
  //       (too restrictive; default OFF)
  //    2. estimate_sat_biases        – estimate per-satellite code
  //       biases for signals without BIA coverage.  Phase ambiguities
  //       absorb satellite phase biases.  (BEST; default ON for PPP-RTK)
  //    3. require_bia_for_signals    – reject CODE measurements without
  //       BIA (phase always kept; ambiguity absorbs sat phase bias).
  //       Auto-set to !estimate_sat_biases.  Also used by the MW
  //       detector for integer widelane rounding.
  // =================================================================
  "estimation": {

    //"estimate_tropo_gradients": false,
    //"estimate_phase_clock": false,              // forced true by uncombined mode
    //"estimate_velocity": false,
    //"estimate_ifb": false,                      
    //"lock_signals_to_clock_ref": false,          // smart default: false for PPP-RTK
    //"require_bia_for_signals": false,            // smart default: !estimate_sat_biases
    "estimate_sat_biases": false,                  // smart default: true for PPP-RTK (code-only)
    //"no_bia_code_downweight": 1.0,
    //"enable_if_slip_detector": false,
    //"accumulate_phase_windup": true,

    // --- Between-satellite single differencing (BSSD) ----------------------
    "between_satellite_sd": {
      "enabled": true,
      "pivot_min_elevation": 45.0
    },

    // --- Ambiguity resolution -----------------------------------------------
    "ambiguity_resolution": {
      "mode": 0, // 0=float, 1=continuous, 2=instantaneous, 3=fix-and-hold
      "ratio_threshold": 3.0,
      "elevation_mask": 20.0,
      "hold_variance": 0.001
    }
  },

  // =================================================================
  //  Kalman filter tuning
  // =================================================================
  "filter": {
    "process_noise": {
      "position_q": 1e2,

      // --- Clock process noise ----------------------------------------------
      "clock_bias_q": 1e3,
      "phase_clock_q": 1e-9,
      "troposphere_q": 1e-8,

      // --- Ionosphere process noise -----------------------------------------
      "ionosphere_q": 0.03,

      "code_bias_q": 1e-4,
      "sat_bias_q": 1e-10,
      "system_time_offset_q": 1e-12,
      "tropo_gradient_q": 5e-12,
      "velocity_q": 1e2
    },
    "initial_std": {
      "position": 1e3,
      "velocity": 100.0,
      "clock": 1e3,
      "troposphere": 0.5,

      // --- Ionosphere initial std -------------------------------------------
      "ionosphere": 5.0,
      "ambiguity": 1e3,
      "code_bias": 10.0,
      "sat_bias": 10.0,
      "system_time_offset": 1e3,
      "tropo_gradient": 0.001
    },
    "measurement_noise": {
      "code_std_m": 0.300,
      "phase_std_m": 0.002,
      "doppler_std_m": 0.5
    },
    // Stochastic model: "constant", "elevation", "snr", or "satellite_block".
    // "satellite_block" uses ATX block type + frequency band to set zenith
    // noise, then applies 1/sin²(el) scaling.
    "stochastic_model": "elevation",
    "snr_model_params": {
      "code_a": 0.10,
      "code_b": 1.00,
      "phase_a": 0.001,
      "phase_b": 0.010,
      "snr_floor_dbhz": 20.0,
      "snr_ceil_dbhz": 55.0
    }
  },

  // =================================================================
  //  Model corrections
  // =================================================================
  "model_corrections": {
    "enable_troposphere": true,
    "enable_relativistic_correction": true,
    "enable_shapiro_delay": true,
    "enable_solid_earth_tide": true,
    "enable_ocean_tide_loading": true,
    "enable_pole_tide": true,
    "enable_atmospheric_loading": true,
    "enable_satellite_pco": true,
    "enable_satellite_pcv": true,
    "enable_receiver_pco": true,
    "enable_receiver_pcv": true,
    "enable_phase_windup": true,
    "enable_code_phase_bias": true
  },

  // =================================================================
  //  Receiver
  // =================================================================
  "receiver": {
    "antenna_orientation": {
      "azimuth_deg": 0.0,
      "elevation_deg": 90.0
    },
    "zhd_pressure_mbar": 1013.25,
    "zhd_temp_kelvin": 288.15
  },

  // =================================================================
  //  IMU
  // =================================================================
  "imu": {
    "enabled": false,
    "coupling_mode": "loosely_coupled",
    "imu_file_path": "",
    "accel_noise_density": 0.05,
    "gyro_noise_density": 5e-4,
    "accel_bias_instability": 1e-4,
    "gyro_bias_instability": 1e-6,
    "initial_accel_bias_std": 0.1,
    "initial_gyro_bias_std": 1e-3,
    "initial_attitude_std": 0.1
  },

  // =================================================================
  //  Data download
  // =================================================================
  "data_download": {
    "enabled": true,
    "data_root": "C:/GnssProcessorSupport/products",
    "product_source": "COD",
    "product_type": "FIN",
    "netrc_path": "",
    "station": "GCGO",
    "station_country": "USA",
    "year": 2024,
    "doy": 129,
    "download_rinex": true,
    "download_products": true,
    "atx_path": "C:/GnssProcessorSupport/products/atx/igs20.atx",
    "nc_path": "C:/GnssProcessorSupport/products/nc/EOT20_load.nc",
    "crx2rnx_path": "C:/GnssProcessorSupport/exe/crx2rnx.exe"
  },

  // =================================================================
  //  Real-time streaming
  // =================================================================
  "realtime": {
    "ntrip_host": "",
    "ntrip_port": 2101,
    "ntrip_mountpoint": "",
    "ntrip_user": "",
    "ntrip_password": "",
    "nmea_gga": "",
    "reconnect_delay_s": 5,
    "input_type": "ntrip",
    "input_path": "",
    "output_type": "console",
    "output_path": "",
    "max_epoch_buffer": 100
  },

  // =================================================================
  //  Logging
  //  Control which spdlog .log files and CSV trace files are produced.
  //  Set any flag to false to suppress that output entirely.
  // =================================================================
  "logging": {
    // --- spdlog file loggers (.log) ------------------------------------
    "enable_main_log": true,
    "enable_gnss_config": true,
    "enable_kalman_filter": true,
    "enable_state_manager": true,
    "enable_ppp_model": false,
    "enable_measurement_model": true,
    "enable_mw_slip_detector": true,
    "enable_if_slip_detector": false,
    "enable_gf_slip_detector": false,
    "enable_cycle_slip_manager": true,
    "enable_ambiguity_resolver": true,
    "enable_corrections": false,
    "enable_geometry": false,
    "enable_troposphere": true,
    "enable_ionosphere": true,
    "enable_antenna": false,
    "enable_antenna_model": true,
    "enable_ocean_tide": true,
    "enable_planetary_model": true,
    "enable_stochastic_model": true,
    "enable_rinex_parser": true,
    "enable_product_parser": true,
    "enable_product_cache": true,
    "enable_resolver": true,
    "enable_state_initializer": true,
    "enable_bssd_pivot_manager": true,
    "enable_bssd_transform": true,
    "enable_ppp_utils": false,
    "enable_downloader": true,
    "enable_ntrip": true,
    "enable_rt_engine": true,
    "enable_imu": true,

    // --- CSV trace files -----------------------------------------------
    "enable_state_trace": true, // state_trace.csv
    "enable_ambiguity_trace": true, // ambiguity_trace.csv
    "enable_ionosphere_trace": true, // ionosphere_trace.csv
    "enable_residual_trace": true, // measurement_residuals.csv
    "enable_wls_trace": true, // wls_trace.csv
    "enable_mw_slip_trace": true, // mwwl_trace.csv
    "enable_if_slip_trace": false, // if_slip_trace.csv
    "enable_gf_slip_trace": false // gf_slip_trace.csv
  }
}
