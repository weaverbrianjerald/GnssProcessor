// =====================================================================
//  GnssProcessor configuration
//
//  This file uses C/C++ style comments (// and /* */).
// =====================================================================
{
  "app_mode": "post", // post, realtime

  // =================================================================
  //  Data source
  //
  //    "internal"   - turnkey mode.  PathResolver globs the bundled
  //                   data/ tree (see files.internal_data_root below)
  //                   for SP3 / CLK / BIA / ERP / ATX / NC / brdc and
  //                   matches RINEX observations by station name.
  //                   No network access; data_download.enabled is
  //                   ignored.  This is the unit-test / demo path.
  //    "production" - real runs.  PathResolver delegates to
  //                   ProductResolver, which downloads any missing
  //                   IGS long-name files from CDDIS into
  //                   data_download.data_root.  Configure year, doy,
  //                   station, etc. in the data_download block below.
  // =================================================================
  "data_source": "internal",

  // =================================================================
  //  Processing
  // =================================================================
  "processing": {
    "mode": "Baseline-Single", // PPP, PPP-RTK, Baseline-Single, Baseline-Differential
    "active_systems": [ "GPS" ],
    "signal_mode": "dual",
    "elevation_mask_deg": 10.0,

    //"run_smoother":  true,

    // --- Signal combination ------------------------------------------------
    //"uncombined_enabled": true,
    // Hard data-gap threshold (seconds).  When the time between two
    // processed epochs exceeds this value, baseline mode resets MW arc
    // statistics on both receivers, erases all DD ambiguities, and
    // forgets sticky pivots so the post-gap epoch starts from clean
    // state.  0 = use built-in default (60 s in baseline mode).
    // "data_gap_tolerance_s": 60.0,
    "leap_seconds_tai": 37.0,
    "relinearize_geometry": false,
    "satellite_interpolation_mode": "lagrange",
    "satellite_clock_interpolation_mode": "linear",
    "excluded_satellites": [],
    "signal_priorities": {
      "GPS": "WCSLXPYMIQ",
      "Galileo": "CBXIQ",
      "GLONASS": "CPIXQ",
      "BeiDou": "IDPXQZ",
      "QZSS": "CSLXIQDEX",
      "SBAS": "CXIQ"
    }
  },

  // =================================================================
  //  Baseline fixture preset
  //
  //  Picks one of the named bundles in
  //  include/config/BaselineFixtures.hpp.  The loader fills in any
  //  field of the baseline section below that you leave blank — your
  //  own values always win.  Set to "Custom" (or omit) to disable
  //  presets entirely.
  //
  //    "IGS_Pasadena" - Caltech (CIT100USA) vs JPL (JPLM00USA),
  //                     ~10 km baseline, 2024-DOY129.  Both stations
  //                     publish to CDDIS daily; bootstrap fetches
  //                     them automatically.
  //    "OSU_Campus"   - Local OSU survey (NARY ref + 233 rover),
  //                     ~340 m baseline, 2023-DOY321.  Not on any
  //                     public archive — you must drop the obs files
  //                     into data/observations/baseline/short/static/
  //                     by hand.
  // =================================================================
  "baseline_fixture": "IGS_Pasadena",

  "baseline": {
    // rinex_path is OPTIONAL in internal-data mode.  If left empty
    // (or omitted) the resolver matches a file by station name under
    // <internal_data_root>/observations/ (recursively).  Set
    // explicitly to override or to point at a file outside the
    // internal tree.  Reference station's position_ecef is required
    // but will be filled in from the preset above when blank.
    "reference": {
      "name": "",
      "rinex_path": "",
      // "position_ecef": [ X, Y, Z ],  // filled from preset when blank
      "fixed": true
    },
    // Single-rover form ("rover" object) and multi-rover form ("rovers"
    // array) are both accepted; provide either or both and they will be
    // concatenated.  Use ProcessingMode "Baseline-Multi" to actually run
    // all configured rovers (Baseline-Single truncates to the first one).
    // In multi-rover mode each rover writes its trace files to
    // logs/rover_<name>/ so they don't collide.
    "rover": {
      "name": "",
      "rinex_path": ""
    },
    // "rovers": [
    //     { "name": "NARY", "rinex_path": "..." },
    //     { "name": "ROV2", "rinex_path": "..." },
    //     { "name": "ROV3", "rinex_path": "..." }
    // ],
    "max_baseline_km": 30.0,
    "epoch_sync_tolerance_s": 0.01,
    // Slice 2a (Phase 2 in the baseline plan): code_only=false enables
    // float phase DDs.  Phase ambiguities are added lazily as new
    // (sat_i, code, pivot) combinations appear and erased by the per-
    // receiver MW slip detector.  Ambiguity fixing (MLAMBDA) is Slice 2b
    // and is gated separately.
    "code_only": false,
    // Pair signals across receivers at the band level when tracking
    // attributes differ (e.g. rover C2W vs reference C2C, both GPS L2).
    // Default true; set false for strict exact-RINEX-code matching.
    "signal_aliasing": true,
    // Use the dual-frequency ionosphere-free combination instead of
    // per-band uncombined DDs.  Required for long baselines (>10-20 km)
    // where DD does NOT cancel the inter-receiver ionospheric delay;
    // optional knob on short baselines for testing / education.  IF
    // phase ambiguities are not integer-cycle, so AR is automatically
    // excluded for IF rows.  Sat-pairs with <2 shared bands are
    // dropped in this mode.  Default false (uncombined).
    "use_iono_free": true,
    // When the per-constellation sticky pivot changes (incumbent left
    // the shared-sat set), apply an S-transformation to re-reference
    // existing DD ambiguities to the new pivot rather than erasing and
    // re-seeding them.  Preserves integer cycle information and
    // eliminates position discontinuities at pivot handovers.  Default
    // true; set false to compare against the legacy reset behavior.
    "enable_pivot_handover": true
  },

  // =================================================================
  //  File paths
  //
  //  All four fields are OPTIONAL.  PathResolver fills in anything
  //  left empty:
  //    - In data_source=internal mode it globs internal_data_root
  //      (defaults to <project_root>/data when not specified — relative
  //      paths here are resolved against the project root, not the
  //      current working directory).
  //    - In data_source=production mode it downloads from CDDIS into
  //      data_download.data_root.
  //
  //  Set observation_path / navigation_path / product_list_path to
  //  pin a specific file and bypass auto-discovery for that input.
  //  product_list_path remains supported as a legacy escape hatch
  //  (one path per line); when empty, PathResolver populates the
  //  product list from the directory layout instead.
  // =================================================================
  "files": {
    "internal_data_root": "./data"
    //"observation_path": "",
    //"navigation_path": "",
    //"product_list_path": ""
  },

  // =================================================================
  //  Estimation toggles
  //
  //  Most toggles are derived automatically from the processing mode
  //  (PPP vs PPP-RTK) and signal mode (dual/triple/all).  Uncomment
  //  any line below to override the smart default.
  //
  //  PPP-RTK bias handling (three strategies, choose via overrides):
  //    1. lock_signals_to_clock_ref  – restrict to clock-ref bands
  //       (too restrictive; default OFF)
  //    2. estimate_sat_biases        – estimate per-satellite code
  //       biases for signals without BIA coverage.  Phase ambiguities
  //       absorb satellite phase biases.  (BEST; default ON for PPP-RTK)
  //    3. require_bia_for_signals    – reject CODE measurements without
  //       BIA (phase always kept; ambiguity absorbs sat phase bias).
  //       Auto-set to !estimate_sat_biases.  Also used by the MW
  //       detector for integer widelane rounding.
  // =================================================================
  "estimation": {

    //"estimate_tropo_gradients": false,
    //"estimate_phase_clock": false,              
    //"estimate_velocity": false,
    //"estimate_ifb": false,
    //"lock_signals_to_clock_ref": false,
    //"require_bia_for_signals": false,
    //"estimate_sat_biases": true,
    //"no_bia_code_downweight": 1.0,
    //"enable_if_slip_detector": false,
    //"accumulate_phase_windup": true,

    // --- Between-satellite single differencing (BSSD) ----------------------
    "between_satellite_sd": {
      //"enabled": true,
      "pivot_min_elevation": 45.0
    },

    // --- Ambiguity resolution -----------------------------------------------
    "ambiguity_resolution": {
      "mode": 0, // 0=float, 1=continuous, 2=instantaneous, 3=fix-and-hold
      "ratio_threshold": 3.0,
      "elevation_mask": 20.0,
      "hold_variance": 0.001
    }
  },

  // =================================================================
  //  Kalman filter tuning
  // =================================================================
  "filter": {
    "process_noise": {
      //"position_q": 1e2, // kinematic
      "position_q": 0.0, // static

      // --- Clock process noise ----------------------------------------------
      "clock_bias_q": 1e3,
      "phase_clock_q": 1e-9,
      "troposphere_q": 1e-8,

      // --- Ionosphere process noise -----------------------------------------
      "ionosphere_q": 0.03,

      "code_bias_q": 1e-4,
      "sat_bias_q": 1e-10,
      "system_time_offset_q": 1e-12,
      "tropo_gradient_q": 5e-12,
      "velocity_q": 1e2
    },
    "initial_std": {
      "position": 1e3,
      "velocity": 100.0,
      "clock": 1e3,
      "troposphere": 0.5,

      // --- Ionosphere initial std -------------------------------------------
      "ionosphere": 5.0,
      "ambiguity": 1e3,
      "code_bias": 10.0,
      "sat_bias": 10.0,
      "system_time_offset": 1e3,
      "tropo_gradient": 0.001
    },
    "measurement_noise": {
      "code_std_m": 0.300,
      "phase_std_m": 0.001,
      "doppler_std_m": 0.5
    },
    // Stochastic model: "constant", "elevation", "snr", or "satellite_block".
    // "satellite_block" uses ATX block type + frequency band to set zenith
    // noise, then applies 1/sin²(el) scaling.
    "stochastic_model": "satellite_block",
    "snr_model_params": {
      "code_a": 0.10,
      "code_b": 1.00,
      "phase_a": 0.001,
      "phase_b": 0.010,
      "snr_floor_dbhz": 20.0,
      "snr_ceil_dbhz": 55.0
    }
  },

  // =================================================================
  //  Model corrections
  // =================================================================
  "model_corrections": {
    "enable_troposphere": true,
    "enable_relativistic_correction": true,
    "enable_shapiro_delay": true,
    "enable_solid_earth_tide": true,
    "enable_ocean_tide_loading": true,
    "enable_pole_tide": true,
    "enable_atmospheric_loading": true,
    "enable_satellite_pco": true,
    "enable_satellite_pcv": true,
    "enable_receiver_pco": true,
    "enable_receiver_pcv": true,
    "enable_phase_windup": true,
    "enable_code_phase_bias": true
  },

  // =================================================================
  //  Receiver
  // =================================================================
  "receiver": {
    "antenna_orientation": {
      "azimuth_deg": 0.0,
      "elevation_deg": 90.0
    },
    "zhd_pressure_mbar": 1013.25,
    "zhd_temp_kelvin": 288.15
  },

  // =================================================================
  //  IMU
  // =================================================================
  "imu": {
    "enabled": false,
    "coupling_mode": "loosely_coupled",
    "imu_file_path": "",
    "accel_noise_density": 0.05,
    "gyro_noise_density": 5e-4,
    "accel_bias_instability": 1e-4,
    "gyro_bias_instability": 1e-6,
    "initial_accel_bias_std": 0.1,
    "initial_gyro_bias_std": 1e-3,
    "initial_attitude_std": 0.1
  },

  // =================================================================
  //  Data download (production mode only)
  //
  //  Used when data_source = "production".  In internal mode every
  //  field below is ignored and the downloader is never invoked.
  //
  //  data_root is the local cache directory; ProductResolver creates
  //  the standard orbit/, clock/, dcb/, erp/, brdc/, rinex/, atx/, nc/
  //  subdirectories under it on first use.  atx_path / nc_path /
  //  crx2rnx_path point at user-supplied static resources that
  //  ProductResolver does not know how to download.
  // =================================================================
  "data_download": {
    "enabled": true,
    "data_root": "C:/GnssProcessorSupport/products",
    "product_source": "COD",
    "product_type": "FIN",
    "netrc_path": "",
    // Production mode picks ONE obs station to download.  For
    // baseline runs you'd typically download the reference and drop
    // the rover in manually, OR run internal mode with bootstrap
    // (the recommended path — see scripts/bootstrap_internal_data.py).
    "station": "CIT1",
    "station_country": "USA",
    "year": 2024,
    "doy": 129,
    "download_rinex": false,
    "download_products": true,
    "atx_path": "C:/GnssProcessorSupport/products/atx/igs20.atx",
    "nc_path": "C:/GnssProcessorSupport/products/nc/EOT20_load.nc",
    "crx2rnx_path": "C:/GnssProcessorSupport/exe/crx2rnx.exe",
    // When false (the default), DataDownloader removes each .gz file
    // after a successful gunzip — saves ~half the cache footprint.
    // Set true if you want to keep the byte-exact compressed copy
    // alongside the decompressed product (e.g. for archival).
    "keep_zip_after_unzip": false
  },

  // =================================================================
  //  Real-time streaming
  // =================================================================
  "realtime": {
    "ntrip_host": "",
    "ntrip_port": 2101,
    "ntrip_mountpoint": "",
    "ntrip_user": "",
    "ntrip_password": "",
    "nmea_gga": "",
    "reconnect_delay_s": 5,
    "input_type": "ntrip",
    "input_path": "",
    "output_type": "console",
    "output_path": "",
    "max_epoch_buffer": 100
  },

  // =================================================================
  //  Logging
  //  Control which spdlog .log files and CSV trace files are produced.
  //  Set any flag to false to suppress that output entirely.
  // =================================================================
  "logging": {
    // --- spdlog file loggers (.log) ------------------------------------
    "enable_main_log": true,
    "enable_gnss_config": true,
    "enable_kalman_filter": true,
    "enable_state_manager": true,
    "enable_ppp_model": false,
    "enable_measurement_model": true,
    "enable_mw_slip_detector": true,
    "enable_if_slip_detector": false,
    "enable_gf_slip_detector": false,
    "enable_cycle_slip_manager": true,
    "enable_ambiguity_resolver": true,
    "enable_corrections": false,
    "enable_geometry": false,
    "enable_troposphere": true,
    "enable_ionosphere": true,
    "enable_antenna": false,
    "enable_antenna_model": true,
    "enable_ocean_tide": true,
    "enable_planetary_model": true,
    "enable_stochastic_model": true,
    "enable_rinex_parser": true,
    "enable_product_parser": true,
    "enable_product_cache": true,
    "enable_resolver": true,
    "enable_state_initializer": true,
    "enable_bssd_pivot_manager": true,
    "enable_bssd_transform": true,
    "enable_ppp_utils": false,
    "enable_downloader": true,
    "enable_ntrip": true,
    "enable_rt_engine": true,
    "enable_imu": true,

    // --- CSV trace files -----------------------------------------------
    "enable_state_trace": true, // state_trace.csv
    "enable_ambiguity_trace": true, // ambiguity_trace.csv
    "enable_ionosphere_trace": true, // ionosphere_trace.csv
    "enable_residual_trace": true, // measurement_residuals.csv
    "enable_wls_trace": true, // wls_trace.csv
    "enable_mw_slip_trace": true, // mwwl_trace.csv
    "enable_if_slip_trace": false, // if_slip_trace.csv
    "enable_gf_slip_trace": false // gf_slip_trace.csv
  }
}
