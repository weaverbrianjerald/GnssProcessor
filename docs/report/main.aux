\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Per-epoch post-processing loop in \texttt {Application::run}. Solid arrows are the intra-epoch sequence; the dashed arrow is the epoch-to-epoch feedback. Steps tagged \textsuperscript  {(P)} run in post-processing only and are skipped on the real-time path (\texttt {RealTimeEngine}). The smoother runs once after the forward pass completes.}}{99}{figure.1}\protected@file@percent }
\newlabel{fig:epoch-loop}{{1}{99}{Per-epoch post-processing loop in \texttt {Application::run}. Solid arrows are the intra-epoch sequence; the dashed arrow is the epoch-to-epoch feedback. Steps tagged \textsuperscript {(P)} run in post-processing only and are skipped on the real-time path (\texttt {RealTimeEngine}). The smoother runs once after the forward pass completes}{figure.1}{}}
\newlabel{fig:epoch-loop@cref}{{[figure][1][]1}{[1][98][]99}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The three differencing regimes share one geometry kernel. Undifferenced residuals are computed once; the strategy selected by \texttt {differencingModeFor} then applies no transform (PPP), a between-satellite single difference against a pivot (PPP-RTK), or a between-receiver$\,\to \,$between-satellite double difference (baseline) before the common Kalman update.}}{100}{figure.2}\protected@file@percent }
\newlabel{fig:differencing}{{2}{100}{The three differencing regimes share one geometry kernel. Undifferenced residuals are computed once; the strategy selected by \texttt {differencingModeFor} then applies no transform (PPP), a between-satellite single difference against a pivot (PPP-RTK), or a between-receiver$\,\to \,$between-satellite double difference (baseline) before the common Kalman update}{figure.2}{}}
\newlabel{fig:differencing@cref}{{[figure][2][]2}{[1][98][]100}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Real-time SSR correction pipeline. Observations, SSR corrections, and broadcast ephemerides are decoded from the byte stream into two stores; the undifferenced observation model then overlays the precise orbit (RAC frame), clock polynomial, and code/phase biases before the Kalman update. A phase-bias discontinuity counter forces an ambiguity reset ahead of the update. See \texttt {RealTimeEngine::processEpoch}.}}{101}{figure.3}\protected@file@percent }
\newlabel{fig:ssr-pipeline}{{3}{101}{Real-time SSR correction pipeline. Observations, SSR corrections, and broadcast ephemerides are decoded from the byte stream into two stores; the undifferenced observation model then overlays the precise orbit (RAC frame), clock polynomial, and code/phase biases before the Kalman update. A phase-bias discontinuity counter forces an ambiguity reset ahead of the update. See \texttt {RealTimeEngine::processEpoch}}{figure.3}{}}
\newlabel{fig:ssr-pipeline@cref}{{[figure][3][]3}{[1][98][]101}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Real-time streaming front-end ahead of the SSR correction stage of \Cref  {fig:ssr-pipeline}. Raw bytes from \texttt {NtripClient}/\texttt {TcpClient} are reassembled into CRC-validated RTCM3 frames by \texttt {RtcmStreamReader}, then decoded and dispatched by \texttt {feedRtcmFrame}: MSM observations accumulate in an edge-triggered epoch buffer, while SSR corrections and broadcast ephemerides flow into their stores. When \texttt {enable\_obs\_ssr\_sync} is set, an obs epoch that runs ahead of the SSR coverage horizon (newest SSR content epoch $+$ \texttt {ssr\_max\_age}) is held in \texttt {held\_obs\_} and re-attempted by \texttt {drainHeldObs} once an SSR push advances the horizon; otherwise it is passed straight to \texttt {processEpoch}. See \Cref  {sec:rt}.}}{102}{figure.4}\protected@file@percent }
\newlabel{fig:rt-stream}{{4}{102}{Real-time streaming front-end ahead of the SSR correction stage of \Cref {fig:ssr-pipeline}. Raw bytes from \texttt {NtripClient}/\texttt {TcpClient} are reassembled into CRC-validated RTCM3 frames by \texttt {RtcmStreamReader}, then decoded and dispatched by \texttt {feedRtcmFrame}: MSM observations accumulate in an edge-triggered epoch buffer, while SSR corrections and broadcast ephemerides flow into their stores. When \texttt {enable\_obs\_ssr\_sync} is set, an obs epoch that runs ahead of the SSR coverage horizon (newest SSR content epoch $+$ \texttt {ssr\_max\_age}) is held in \texttt {held\_obs\_} and re-attempted by \texttt {drainHeldObs} once an SSR push advances the horizon; otherwise it is passed straight to \texttt {processEpoch}. See \dcref {sec:rt}{the real-time engine}}{figure.4}{}}
\newlabel{fig:rt-stream@cref}{{[figure][4][]4}{[1][98][]102}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces PPP-RTK network producer joint estimator (\texttt {NetworkEstimator}). Each epoch the shared satellite-side columns---one per (satellite, parameter-kind, signal) for the estimable clock, code bias, and phase bias---are registered once, then \texttt {beginEpoch} opens an arrowhead normal-equation system of that width. \texttt {addStation} contributes one pre-formed block of local-vs-shared design rows per station (the network applies no receiver-side differencing); the local nuisances are Schur-reduced out, leaving a reduced shared system that is rank-deficient by the gauge freedoms. \texttt {solve} pins those with an explicit minimum-constraint S-basis datum on a copy of the reduced system, and \texttt {toSolutionEpoch} maps the shared estimate to an emittable record that \texttt {NetworkProductEmitter} serializes in IGS-SSR convention. The single-epoch estimator core is validated on a synthetic noise-free network; the live \texttt {runNetwork()} epoch loop is staged. See \Cref  {sec:net}.}}{103}{figure.5}\protected@file@percent }
\newlabel{fig:net-flow}{{5}{103}{PPP-RTK network producer joint estimator (\texttt {NetworkEstimator}). Each epoch the shared satellite-side columns---one per (satellite, parameter-kind, signal) for the estimable clock, code bias, and phase bias---are registered once, then \texttt {beginEpoch} opens an arrowhead normal-equation system of that width. \texttt {addStation} contributes one pre-formed block of local-vs-shared design rows per station (the network applies no receiver-side differencing); the local nuisances are Schur-reduced out, leaving a reduced shared system that is rank-deficient by the gauge freedoms. \texttt {solve} pins those with an explicit minimum-constraint S-basis datum on a copy of the reduced system, and \texttt {toSolutionEpoch} maps the shared estimate to an emittable record that \texttt {NetworkProductEmitter} serializes in IGS-SSR convention. The single-epoch estimator core is validated on a synthetic noise-free network; the live \texttt {runNetwork()} epoch loop is staged. See \dcref {sec:net}{the network mode}}{figure.5}{}}
\newlabel{fig:net-flow@cref}{{[figure][5][]5}{[1][98][]103}{}{}{}}
