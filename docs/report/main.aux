\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Per-epoch post-processing loop in \texttt  {Application::run}. Solid arrows are the intra-epoch sequence; the dashed arrow is the epoch-to-epoch feedback. Steps tagged \textsuperscript  {(P)} run in post-processing only and are skipped on the real-time path (\texttt  {RealTimeEngine}). The smoother runs once after the forward pass completes.}}{37}{figure.1}\protected@file@percent }
\newlabel{fig:epoch-loop}{{1}{37}{Per-epoch post-processing loop in \texttt {Application::run}. Solid arrows are the intra-epoch sequence; the dashed arrow is the epoch-to-epoch feedback. Steps tagged \textsuperscript {(P)} run in post-processing only and are skipped on the real-time path (\texttt {RealTimeEngine}). The smoother runs once after the forward pass completes}{figure.1}{}}
\newlabel{fig:epoch-loop@cref}{{[figure][1][]1}{[1][36][]37}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The three differencing regimes share one geometry kernel. Undifferenced residuals are computed once; the strategy selected by \texttt  {differencingModeFor} then applies no transform (PPP), a between-satellite single difference against a pivot (PPP-RTK), or a between-receiver$\,\to \,$between-satellite double difference (baseline) before the common Kalman update.}}{38}{figure.2}\protected@file@percent }
\newlabel{fig:differencing}{{2}{38}{The three differencing regimes share one geometry kernel. Undifferenced residuals are computed once; the strategy selected by \texttt {differencingModeFor} then applies no transform (PPP), a between-satellite single difference against a pivot (PPP-RTK), or a between-receiver$\,\to \,$between-satellite double difference (baseline) before the common Kalman update}{figure.2}{}}
\newlabel{fig:differencing@cref}{{[figure][2][]2}{[1][36][]38}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Real-time SSR correction pipeline. Observations, SSR corrections, and broadcast ephemerides are decoded from the byte stream into two stores; the undifferenced observation model then overlays the precise orbit (RAC frame), clock polynomial, and code/phase biases before the Kalman update. A phase-bias discontinuity counter forces an ambiguity reset ahead of the update. See \texttt  {RealTimeEngine::processEpoch}.}}{39}{figure.3}\protected@file@percent }
\newlabel{fig:ssr-pipeline}{{3}{39}{Real-time SSR correction pipeline. Observations, SSR corrections, and broadcast ephemerides are decoded from the byte stream into two stores; the undifferenced observation model then overlays the precise orbit (RAC frame), clock polynomial, and code/phase biases before the Kalman update. A phase-bias discontinuity counter forces an ambiguity reset ahead of the update. See \texttt {RealTimeEngine::processEpoch}}{figure.3}{}}
\newlabel{fig:ssr-pipeline@cref}{{[figure][3][]3}{[1][36][]39}{}{}{}}
