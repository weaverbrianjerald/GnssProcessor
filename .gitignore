# .gitignore
.vs/
build/
.venv/
# Python virtualenv checked into the tree by mistake; untrack with
# `git rm -r --cached venv` (the working copy is left in place).
venv/
*.o
*.exe
*.pyc
# pybind11 module is copied into python/ on every build (CMake)
*.pyd
# MATLAB editor autosave backups
*.asv
__pycache__/
reference_software/
# Test-suite run outputs (per-cell logs, scorecards, suite_metrics.json).
# Regenerated by scripts/run_test_suite.py; the golden baseline can be
# committed deliberately if desired (see docs/test_suite.md).
test_suite_results/
favorites_report_*/

# -------------------------------------------------------------------
# Internal-mode test fixtures (date-first unified layout).
#
# data/ is populated by scripts/bootstrap_internal_data.py from
# canonical sources (CDDIS for IGS products, files.igs.org for ATX,
# DGFI-TUM for the EOT20 ocean tide model, etc.) on first use.  None
# of the bulk content belongs in version control:
#
#   - SP3 / CLK / BIA / ERP / BRDC : tens of MB each, multi-day sets
#   - obs RINEX                    : up to ~35 MB per station-day
#   - igs20.atx                    : ~41 MB
#   - EOT20_load.nc                : ~280 MB
# -------------------------------------------------------------------
# Date-keyed fixture subtrees (e.g. data/2024-129/products/...)
data/[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9]/
# Date-independent assets and raw download cache (production-mode).
# Ignore the bulk static assets (sinex SSC, SIF, ATX, EOT20 nc, gpt3 grids)
# but KEEP the tiny site-truth database: a few hand-established coordinates for
# non-IGS receivers (the real-time replay tier) that are NOT auto-fetchable.
data/static/*
!data/static/sites/
data/cache/
# User-managed debug RINEX subsets (e.g. trimmed 1-hour files for
# fast iteration); pinned by some configs via files.observation_path.
data/rinex/

# One-time migration artifacts from the flat→date-first refactor —
# preserved README content from the old layout.
data/*.legacy

# -------------------------------------------------------------------
# Orchestrator outputs (scripts/run_batch.py).
#
# Each cell writes its run_config.json, captured stdout/stderr, and
# a logs/ tree (state_trace.csv etc.) under here.  Can grow to GBs
# across a multi-week batch.
# -------------------------------------------------------------------
batch_results/
batch_results_*/

# Top-level logs/ when running gnss_processor.exe directly from the
# repo root (cwd-relative log_dir_ default in Application).
logs/

# Orphan from a pre-refactor staging experiment.  Production-mode
# cache lives at C:/GnssProcessorSupport/products/ per the configs;
# nothing references this in-tree directory anymore.
data_production/

# -------------------------------------------------------------------
# Runtime debug dumps written to the repo root by gnss_processor.exe
# (e.g. kalman_debug.log, a 90+ MB Kalman trace).  The logs/ dir is
# already ignored above; this also covers docs/report/main.log.
# -------------------------------------------------------------------
*.log

# -------------------------------------------------------------------
# LaTeX build artifacts (docs/report).  The source is main.tex + *.bib
# plus the curated wrappers pipeline_diagrams.tex and generated_tables.tex
# (the latter \input's the code-generated fragments below); everything
# here is regenerable by latexmk/biber.  main.pdf is left TRACKED as the
# rendered deliverable — add docs/report/main.pdf here to drop the binary.
# -------------------------------------------------------------------
docs/report/*.aux
docs/report/*.bbl
docs/report/*.bcf
docs/report/*.blg
docs/report/*.fdb_latexmk
docs/report/*.fls
docs/report/*.out
docs/report/*.run.xml
docs/report/*.toc
docs/report/*.synctex.gz
# Code-generated table fragments (scripts/gen_report_tables.py); the
# authored generated_tables.tex wrapper that \input's them is kept.
docs/report/generated/

# CTest scratch output (Testing/Temporary/LastTest.log, CTestCostData.txt).
Testing/
